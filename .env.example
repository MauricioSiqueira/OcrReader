# Copie para ".env" (nunca versionado) e preencha os valores reais.
# Todas as variáveis usam o prefixo OCR_READER_ e são opcionais: sem elas, valem os padrões do código.

# Hosts aceitos como origem do SAS URI (JSON array). Barreira contra SSRF — não afrouxe sem motivo.
OCR_READER_HOSTS_PERMITIDOS=["*.blob.core.windows.net"]

# Tamanho máximo aceito de arquivo, em bytes. Padrão: 500 MiB.
OCR_READER_TAMANHO_MAXIMO_EM_BYTES=524288000

# Janela inicial de leitura do cabeçalho remoto, em bytes. Padrão: 8 KiB.
OCR_READER_JANELA_DE_CABECALHO_EM_BYTES=8192

# Janela ampliada de releitura quando a detecção do tipo fica ambígua. Padrão: 512 KiB.
OCR_READER_JANELA_AMPLIADA_EM_BYTES=524288

# Timeout das chamadas HTTP de leitura remota, em segundos.
OCR_READER_TIMEOUT_EM_SEGUNDOS=10.0

# Endpoint do recurso Azure Document Intelligence. Placeholder — nunca um endpoint real aqui.
OCR_READER_ENDPOINT_DO_DOCUMENT_INTELLIGENCE=https://SEU-RECURSO.cognitiveservices.azure.com

# Chave do recurso Azure Document Intelligence. Segredo — placeholder, nunca a chave real aqui.
OCR_READER_CHAVE_DO_DOCUMENT_INTELLIGENCE=substitua-por-sua-chave-do-azure

# Id do modelo do Document Intelligence usado na extração.
OCR_READER_ID_DO_MODELO_DE_OCR=prebuilt-read

# Versão da API do Document Intelligence.
OCR_READER_VERSAO_DA_API_DE_OCR=2024-11-30
